# Copy to .env only if you do not already have a local configuration.
# Set the URI of your own non-production replica set or sharded cluster.
# The URI must explicitly select /purainamart. No database is provisioned here.
MONGODB_URI=
NODE_ENV=development
PORT=4173
DEV_HOST=127.0.0.1

# Required to manage an empty store; mandatory at production startup.
# Generate the hash interactively with: node scripts/hash-password.mjs
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Administrator

# Optional Google OAuth web client; configure the exact browser origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional signed Cloudinary uploads; keep this server-side secret private.
CLOUDINARY_URL=

# Optional Firebase web push. Public web config is served to browsers.
PUBLIC_APP_ORIGIN=http://127.0.0.1:4173
FCM_PROJECT_ID=
FCM_WEB_API_KEY=
FCM_WEB_AUTH_DOMAIN=
FCM_WEB_PROJECT_ID=
FCM_WEB_MESSAGING_SENDER_ID=
FCM_WEB_APP_ID=
FCM_WEB_VAPID_KEY=
# Prefer workload identity / Application Default Credentials. If needed, set
# GOOGLE_APPLICATION_CREDENTIALS to a private file outside this repository.
