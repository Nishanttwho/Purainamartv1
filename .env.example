NODE_ENV=development
PORT=4173

# Optional in development. Production requires PostgreSQL and refuses JSON fallback.
# Use distinct database URLs for development, testing, and production.
DATABASE_URL=
PG_POOL_MAX=5
# PostgreSQL integration tests are opt-in. Use a disposable, separate database,
# set NODE_ENV=test, and confirm its exact DB name before tests create/drop a schema.
POSTGRES_TEST_DATABASE_URL=
POSTGRES_TEST_CONFIRM_DATABASE=
# Set only for a local PostgreSQL instance without TLS; production rejects this.
# PGSSL=disable

# Configure secrets in the process environment or a private deployment secret store.
# ADMIN_PHONE=
# ADMIN_NAME=
# ADMIN_PASSWORD_HASH=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Firebase web client config is public browser configuration; VAPID is a public key.
# Populate from Firebase Console > Project settings > General and Cloud Messaging.
FCM_WEB_API_KEY=
FCM_WEB_AUTH_DOMAIN=
FCM_WEB_PROJECT_ID=
FCM_WEB_MESSAGING_SENDER_ID=
FCM_WEB_APP_ID=
FCM_WEB_VAPID_KEY=
# Backend only: Firebase target project and Application Default Credentials.
# Keep the service-account JSON outside the repository and set its path privately,
# or use the hosting provider's workload identity / ADC.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
PUBLIC_APP_ORIGIN=

# Cloudinary signed image uploads. Keep the API secret on the server only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively configure CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
